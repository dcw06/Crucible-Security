# Crucible — Environment Variables
# Copy to .env and fill in real values before running anything.

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your_webhook_secret   # must match your repo's webhook settings
GITHUB_OWNER=your_org_or_username
GITHUB_REPO=your_repo_name

# Production is fail-closed: unsigned webhooks are never accepted.
APP_ENV=production
ALLOW_UNSIGNED_WEBHOOKS=false

# ── UiPath Test Cloud ──────────────────────────────────────────────────────
TC_BASE_URL=https://cloud.uipath.com/{org}/{tenant}
TC_TOKEN=your_tc_bearer_token
TC_PROJECT_ID=your_project_id
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_ORGANIZATION=
UIPATH_TENANT=DefaultTenant
UIPATH_SCOPES=TM.Projects TM.TestCases TM.TestSets TM.TestExecutions

# ── UiPath Maestro (optional) ──────────────────────────────────────────────
# Pipeline skips Maestro gracefully if these are unset.
MAESTRO_BASE_URL=https://cloud.uipath.com/{org}/{tenant}/orchestrator_
MAESTRO_TOKEN=your_maestro_token

# ── Development flags ──────────────────────────────────────────────────────
# Set TC_DRY_RUN=true to stub tc_pass_rate=0.25 — no TC API calls made.
# Useful for iterating on agents and confidence score without burning quota.
TC_DRY_RUN=false

# Model-generated tests are never executed in the application container.
# Keep disabled unless an independently isolated HTTPS sandbox is configured.
TEST_EXECUTION_MODE=disabled
TEST_SANDBOX_URL=
TEST_SANDBOX_TOKEN=
TEST_SANDBOX_ATTESTATION_SECRET=

# Upload-scanner access control and bounded resource admission.
SCANNER_ACCESS_TOKEN=replace_with_a_long_random_value
ALLOW_UNAUTHENTICATED_SCANNER=false
SCANNER_MAX_CONCURRENT=1
SCANNER_RATE_LIMIT=2
SCANNER_RATE_WINDOW_SECONDS=3600
SCANNER_BYTE_QUOTA_BYTES=419430400
SCANNER_REPLICAS=1
MAX_CLAUDE_CHUNKS=4
SEMGREP_TIMEOUT_SECONDS=180
CLAUDE_REVIEW_TIMEOUT_SECONDS=120
CLAUDE_REVIEW_MAX_RETRIES=2
CLAUDE_REVIEW_MAX_OUTPUT_TOKENS=16384
WEB_EGRESS_PROXY_URL=
REQUIRE_WEB_EGRESS_GATEWAY=false
WEB_EGRESS_GATEWAY_ATTESTED=false
MAX_ARCHIVE_UPLOAD_BYTES=209715200
MAX_SOURCE_UPLOAD_BYTES=209715200
MAX_EXTRACTED_BYTES=524288000
MAX_SYNTAX_FILE_BYTES=10485760
MAX_CLAUDE_FILE_BYTES=5242880
SCANNER_SCRATCH_DIR=/var/lib/crucible-scratch

# Optional separately operated native inspection workers. Each endpoint must
# use HTTPS and enforce the isolation profile documented in desktop-worker/.
DESKTOP_INSPECTION_MODE=disabled
DESKTOP_WINDOWS_WORKER_URL=
DESKTOP_WINDOWS_WORKER_TOKEN=
DESKTOP_WINDOWS_LAUNCHER_PUBLIC_KEY_PATH=
DESKTOP_MACOS_WORKER_URL=
DESKTOP_MACOS_WORKER_TOKEN=
DESKTOP_MACOS_LAUNCHER_PUBLIC_KEY_PATH=
DESKTOP_LINUX_WORKER_URL=
DESKTOP_LINUX_WORKER_TOKEN=
DESKTOP_LINUX_LAUNCHER_PUBLIC_KEY_PATH=

# Optional separately operated Playwright browser sandbox.
WEB_DYNAMIC_MODE=disabled
BROWSER_SANDBOX_URL=
BROWSER_SANDBOX_TOKEN=
BROWSER_SANDBOX_ATTESTATION_SECRET=
# Comma-separated hosts explicitly authorized for browser testing.
WEB_ALLOWED_HOSTS=

# Durable webhook-worker polling and lease ownership
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=900
MAX_WEBHOOK_BODY_BYTES=2097152

# SQLite path shared between FastAPI webhook server and Streamlit dashboard.
# Required in production. Development may use the local SQLite path.
DATABASE_URL=
STATE_DB=/var/lib/crucible/crucible_state.db
