ANTHROPIC_API_KEY=
SEMGREP_TIMEOUT_SECONDS=180
CLAUDE_REVIEW_TIMEOUT_SECONDS=120
CLAUDE_REVIEW_MAX_RETRIES=2
CLAUDE_REVIEW_MAX_OUTPUT_TOKENS=16384
WEB_EGRESS_PROXY_URL=
REQUIRE_WEB_EGRESS_GATEWAY=false
WEB_EGRESS_GATEWAY_ATTESTED=false
WEB_DYNAMIC_MODE=disabled
BROWSER_SANDBOX_URL=
BROWSER_SANDBOX_TOKEN=
BROWSER_SANDBOX_ATTESTATION_SECRET=
WEB_ALLOWED_HOSTS=
CODE_PIPELINE_WRITER_MODEL=claude-opus-4-7
CODE_PIPELINE_CRITIC_MODEL=claude-opus-4-7
CODE_PIPELINE_MAX_ITERATIONS=5
CODE_PIPELINE_MAX_OUTPUT_TOKENS=4096
CODE_PIPELINE_TOTAL_TOKEN_BUDGET=32000
CODE_PIPELINE_TIMEOUT_MS=120000
# MCP only: set true to permit fallback to ~/.claude/.env or ~/.env.
CODE_PIPELINE_ALLOW_KEY_FILE=false

# ── GitHub ─────────────────────────────────────────────────────────────────
# Required for receiving webhooks and posting PR comments.

# Personal access token (classic) or fine-grained token with:
#   - repo  → read PR files  (GET /pulls/{n}/files)
#   - issues → post comments (POST /issues/{n}/comments)
GITHUB_TOKEN=

# Your GitHub username or org name (the "owner" part of owner/repo)
GITHUB_OWNER=

# The repository name (no owner prefix)
GITHUB_REPO=

# Webhook secret — set this in GitHub → Settings → Webhooks → Secret.
# Production fails closed when this is omitted. Development bypass requires
# APP_ENV=development and ALLOW_UNSIGNED_WEBHOOKS=true.
GITHUB_WEBHOOK_SECRET=
APP_ENV=production
ALLOW_UNSIGNED_WEBHOOKS=false
MAX_WEBHOOK_BODY_BYTES=2097152

# ── Test Cloud (TC) ────────────────────────────────────────────────────────
# Required for real TC integration. All three are needed together.
TC_BASE_URL=
MAESTRO_BASE_URL=
TC_TOKEN=
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_ORGANIZATION=
UIPATH_TENANT=
UIPATH_SCOPES=TM.Projects TM.TestCases TM.TestSets TM.TestExecutions
TC_PROJECT_ID=

# Set to "true" to skip all TC API calls and use stub data instead.
# Stub returns tc_pass_rate=0.25, which produces the demo confidence=0.37
# when iteration=2 and any_critical=True.
TC_DRY_RUN=


# ── Maestro ────────────────────────────────────────────────────────────────
# Optional. Only needed if you want CRITICAL findings to open Maestro cases.
# If either is blank, Crucible logs the finding locally and skips the case.
MAESTRO_TOKEN=


# ── State DB ───────────────────────────────────────────────────────────────
# Optional. Path to the SQLite file shared between FastAPI and Streamlit.
# Defaults to /tmp/crucible_state.db if not set.
# Change this if you want the DB to survive reboots or live outside /tmp.
STATE_DB=
